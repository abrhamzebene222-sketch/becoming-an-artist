# Copy this file to server/.env for running on your own computer.
# On Render, add the same names under your service › Environment (never commit real values to GitHub).

PORT=4000

# ---- MongoDB Atlas ----
# Atlas › Database › Connect › Drivers. Replace USER and PASSWORD with a Database Access user.
# (If the password has special characters like @ : / ? # [ ], URL-encode them, e.g. @ → %40)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.aqqojuk.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0
MONGO_DB_NAME=becoming-an-artist

# Long random string (login tokens). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Cloudinary (lesson videos, PDFs and payment screenshots) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=becoming-an-artist
# Optional, paid Cloudinary plans only: makes lesson links expire after 2 hours
CLOUDINARY_AUTH_TOKEN_KEY=

# ---- First admin account (created on first start if no admin exists) ----
ADMIN_NAME=Abrham
ADMIN_EMAIL=Artistabrham@gmail.com
ADMIN_PASSWORD=

# Your public site address(es), comma-separated (Render URL / custom domain). Used for CORS.
PUBLIC_ORIGIN=https://becoming-an-artist.onrender.com
