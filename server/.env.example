# ---- Server ----
PORT=4000
# Long random string. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Public URL students use (your Cloudflare Tunnel hostname). Used for CORS.
PUBLIC_ORIGIN=http://localhost:5173

# ---- Cloudinary (lesson videos + PDFs) ----
# Find these on https://console.cloudinary.com → Settings → API Keys (or the Dashboard).
# KEEP THE SECRET PRIVATE: it belongs only in this file on the server, never in the client or the APK.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Folder in your Cloudinary Media Library for lessons
CLOUDINARY_FOLDER=becoming-an-artist/lessons
# Optional, paid plans only: token-based auth key, makes video links expire after 2 hours
CLOUDINARY_AUTH_TOKEN_KEY=

# Where payment screenshots are saved (never publicly served)
RECEIPTS_DIR=./storage/receipts
DB_FILE=./storage/app.db

# ---- First admin account (created on first run) ----
ADMIN_NAME=Abrham
ADMIN_EMAIL=Artistabrham@gmail.com
ADMIN_PASSWORD=change-me-now
